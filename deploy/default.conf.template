resolver 127.0.0.11 valid=5s ipv6=off;

upstream pdftrack_extractor {
    zone pdftrack_extractor 64k;
    least_conn;
    server extractor:8000 resolve;
}

upstream pdftrack_documents {
    zone pdftrack_documents 64k;
    least_conn;
    server documents:8001 resolve;
}

server {
    listen 80;
    client_max_body_size ${MAX_BODY_SIZE};

    location /api/ {
        proxy_pass http://pdftrack_documents;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout ${API_READ_TIMEOUT};
        proxy_send_timeout ${API_READ_TIMEOUT};
    }

    location / {
        proxy_pass http://pdftrack_extractor;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout ${API_READ_TIMEOUT};
        proxy_send_timeout ${API_READ_TIMEOUT};
    }
}
